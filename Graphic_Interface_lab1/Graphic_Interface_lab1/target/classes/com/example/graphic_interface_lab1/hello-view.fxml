<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="438.0" prefWidth="455.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.graphic_interface_lab1.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Label prefHeight="30.0" prefWidth="61.0" text="LOGIN" textAlignment="CENTER">
      <font>
         <Font size="20.0" />
      </font>
   </Label>
   <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="46.0" prefWidth="201.0">
      <children>
         <Label text="User name" />
         <TextField maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="200.0" />
      </children>
   </VBox>
   <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="46.0" prefWidth="201.0">
      <children>
         <Label text="Password" />
         <TextField accessibleRole="PASSWORD_FIELD" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="200.0" />
      </children>
   </VBox>
   <VBox alignment="TOP_CENTER" prefHeight="74.0" prefWidth="278.0" spacing="20.0">
      <children>
         <Button mnemonicParsing="false" onAction="#onHelloButtonClick" prefHeight="25.0" prefWidth="203.0" text="Login" />
         <Button mnemonicParsing="false" onAction="#onHelloButtonClick" prefHeight="25.0" prefWidth="207.0" text="Autentificare" />
      </children>
      <VBox.margin>
         <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </VBox.margin>
   </VBox>
   <Label fx:id="welcomeText" />
   <Button mnemonicParsing="false" onAction="#onNextTaskClick" text="next" />
</VBox>
